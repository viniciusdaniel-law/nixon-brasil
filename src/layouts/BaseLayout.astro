---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { imageAtWidth } from '../lib/images';
import seo from '../data/settings/seo.json';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  author?: string;
}

const {
  title,
  description,
  image = seo.defaultImage,
  type = 'website',
  publishedAt,
  updatedAt,
  author,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === seo.siteName ? title : `${title} — ${seo.siteName}`;
const base = import.meta.env.BASE_URL;
const socialImage = imageAtWidth(image, 1600);
const contentSecurityPolicy = [
  "default-src 'self'",
  "base-uri 'self'",
  "connect-src 'self'",
  "font-src 'self'",
  "form-action 'self'",
  "frame-src 'none'",
  "img-src 'self' https://commons.wikimedia.org https://upload.wikimedia.org",
  "media-src 'none'",
  "object-src 'none'",
  "script-src 'self'",
  "style-src 'self'",
  'upgrade-insecure-requests',
].join('; ');
const structuredData = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: socialImage,
      url: canonical.toString(),
      inLanguage: seo.language,
      datePublished: publishedAt?.toISOString(),
      dateModified: (updatedAt ?? publishedAt)?.toISOString(),
      author: { '@type': 'Person', name: author ?? 'Vinicius Daniel' },
      publisher: { '@type': 'Organization', name: seo.siteName },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: seo.siteName,
      description,
      url: canonical.toString(),
      inLanguage: seo.language,
      publisher: { '@type': 'Organization', name: seo.siteName },
    };
const serializedStructuredData = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={seo.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#071a34" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Nixon Brasil" href={`${base}rss.xml`} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{fullTitle}</title>
    <script is:inline type="application/ld+json" set:html={serializedStructuredData} />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>
