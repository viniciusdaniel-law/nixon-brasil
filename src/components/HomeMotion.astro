---
const base = import.meta.env.BASE_URL;
---

<!--
  Motion is route-scoped and progressively enhanced. The page remains complete
  when these scripts fail, are blocked, or the user requests reduced motion.
-->
<script
  is:inline
  defer
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
  src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"
></script>
<script
  is:inline
  defer
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
  src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/ScrollTrigger.min.js"
></script>
<script is:inline defer src={`${base}scripts/home-motion.js`}></script>
