---
import menu from '../data/settings/menu.json';

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const links = menu.links.map((link) => [link.label, link.url.replace(/^\//, '')]);

const active = (href: string) => path === `${base}${href}` || path.startsWith(`${base}${href}`);
---
<header class="site-header">
  <div class="shell nav-row">
    <a class="wordmark" href={base} aria-label="Nixon Brasil, início">
      <strong>NIXON BRASIL</strong>
      <span>O legado de Richard Nixon em português</span>
    </a>
    <nav class="main-nav desktop-nav" aria-label="Navegação principal">
      {links.map(([label, href]) => (
        <a
          class:list={{ active: active(href) }}
          aria-current={active(href) ? 'page' : undefined}
          href={`${base}${href}`}
        >
          {label}
        </a>
      ))}
    </nav>
    <details class="nav-menu">
      <summary>Menu</summary>
      <nav class="main-nav mobile-nav" aria-label="Navegação móvel">
        {links.map(([label, href]) => (
          <a
            class:list={{ active: active(href) }}
            aria-current={active(href) ? 'page' : undefined}
            href={`${base}${href}`}
          >
            {label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
