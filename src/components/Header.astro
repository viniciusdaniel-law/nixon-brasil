---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const links = [
  ['Biografia', 'biografia/'],
  ['Presidência', 'presidencia/'],
  ['Política externa', 'politica-externa/'],
  ['Brasil', 'brasil/'],
  ['Acervo', 'acervo/'],
  ['Artigos', 'artigos/'],
  ['Vídeos', 'videos/'],
];

const active = (href: string) => path === `${base}${href}` || path.startsWith(`${base}${href}`);
---
<header class="site-header">
  <div class="shell nav-row">
    <a class="wordmark" href={base} aria-label="Nixon Brasil, início">
      <strong>NIXON BRASIL</strong>
      <span>Richard Nixon em português</span>
    </a>
    <details class="nav-menu">
      <summary>Menu</summary>
      <nav class="main-nav" aria-label="Navegação principal">
        {links.map(([label, href]) => (
          <a
            class:list={{ active: active(href) }}
            aria-current={active(href) ? 'page' : undefined}
            href={`${base}${href}`}
          >
            {label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
