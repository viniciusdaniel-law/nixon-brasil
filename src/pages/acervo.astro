---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const docs = (await getCollection('documentos')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Acervo" description="Documentos, discursos, fotografias, gravações e leis relacionados à vida e à Presidência de Richard Nixon.">
  <section class="page-hero light"><div class="shell"><p class="kicker">Fontes primárias</p><h1>Acervo</h1><p>Registros selecionados com referência oficial, arquivo de origem, situação da tradução e acesso ao documento original.</p></div></section>
  <section class="section"><div class="shell">
    <div class="archive-toolbar">
      <input id="archive-search" type="search" placeholder="Pesquisar título, tema ou arquivo" aria-label="Pesquisar no acervo" />
      <select id="archive-filter" aria-label="Filtrar por tema"><option value="">Todos os temas</option><option>Biografia</option><option>Presidência</option><option>Política externa</option><option>Nixon e o Brasil</option></select>
    </div>
    <div class="archive-list" id="archive-list">
      {docs.map((doc) => (
        <a class="archive-row" href={doc.data.originalUrl} target="_blank" rel="noreferrer" data-search={`${doc.data.title} ${doc.data.originalTitle ?? ''} ${doc.data.category} ${doc.data.archive ?? ''} ${doc.data.reference ?? ''}`.toLowerCase()} data-category={doc.data.category}>
          <time datetime={doc.data.date.toISOString()}>{doc.data.date.toLocaleDateString('pt-BR')}</time>
          <div><span class="card-meta">{doc.data.format} · {doc.data.category}</span><h3>{doc.data.title}</h3><p>{doc.data.description}</p></div>
          <div class="archive-meta">{doc.data.archive}<br />{doc.data.translationStatus} ↗</div>
        </a>
      ))}
    </div>
    <p id="archive-empty" hidden>Nenhum documento corresponde aos filtros.</p>
  </div></section>
  <script is:inline src={`${base}scripts/acervo.js`} defer></script>
</BaseLayout>
