---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const articles = (await getCollection('artigos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

// The homepage lead is an editorial decision, not merely the newest file.
// China is the strongest institutional entry point while the corpus is still small.
const lead = articles.find((article) => article.id === 'abertura-china') ?? articles[0];
const rest = articles.filter((article) => article.id !== lead?.id).slice(0, 4);

function coverOf(article: (typeof articles)[number]) {
  const raw = article.data.cover ?? '';
  if (!raw) return '';
  return raw.startsWith('http') ? raw : `${base}${raw.replace(/^\//, '')}`;
}
---
<BaseLayout
  title="Nixon Brasil"
  description="Publicação histórica e acervo digital sobre Richard Nixon em português: biografia, presidência, política externa e o dossiê Brasil."
>
  <section class="hero hero-v2">
    <img
      class="hero-media"
      src="https://commons.wikimedia.org/wiki/Special:Redirect/file/NIXONcampaigns.jpg"
      alt="Richard Nixon em campanha diante de uma multidão em 1968"
      width="1600"
      height="900"
      fetchpriority="high"
      decoding="async"
    />
    <div class="shell-wide hero-content">
      <div class="hero-copy">
        <p class="kicker light">1913 — 1994 · 37º Presidente dos Estados Unidos</p>
        <h1>Arquivo e ensaio sobre Richard Nixon, em português.</h1>
        <p class="hero-lead">
          Publicação independente dedicada à vida, à Presidência e à política externa de Richard Nixon,
          com fontes primárias, ensaios e traduções em português.
        </p>
        <div class="actions">
          <a class="btn primary" href={`${base}artigos/`}>Ler os artigos</a>
          <a class="btn ghost" href={`${base}acervo/`}>Abrir o acervo</a>
        </div>
      </div>
    </div>
    <div class="hero-note">
      <div class="shell-wide">
        <span>Fontes-base: Nixon Library / NARA · FRUS · American Presidency Project</span>
        <span>Fotografia: Ollie Atkins / NARA · domínio público</span>
      </div>
    </div>
  </section>

  {lead && (
    <section class="section white home-feature">
      <div class="shell-main">
        <div class="editorial-head">
          <h2>Leitura em destaque</h2>
          <a href={`${base}artigos/`}>Todos os artigos →</a>
        </div>

        <div class="editorial-grid">
          <a class="lead-story" href={`${base}artigos/${lead.id}/`}>
            {coverOf(lead)
              ? <img src={coverOf(lead)} alt={lead.data.coverAlt ?? ''} width="1200" height="675" loading="eager" decoding="async" />
              : <div class="card-cover-fallback lead-fallback" aria-hidden="true">{lead.data.category}</div>}
            <span class="card-meta">{lead.data.category} · {lead.data.publishedAt.toLocaleDateString('pt-BR')}</span>
            <h3>{lead.data.title}</h3>
            <p>{lead.data.subtitle ?? lead.data.description}</p>
          </a>

          {rest.length > 0 && (
            <div class="compact-list" aria-label="Outros artigos em destaque">
              {rest.map((article) => (
                <a class="compact-story" href={`${base}artigos/${article.id}/`}>
                  <span class="card-meta">{article.data.category}</span>
                  <h3>{article.data.title}</h3>
                  <p>{article.data.description}</p>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="section home-index-section">
    <div class="shell-main">
      <div class="editorial-head">
        <h2>Percursos de pesquisa</h2>
      </div>
      <div class="index-list">
        <a class="index-row" href={`${base}politica-externa/`}>
          <span class="card-meta">Diplomacia</span>
          <div>
            <h3>Política externa</h3>
            <p>China, détente e o triângulo estratégico.</p>
          </div>
          <span class="index-cta">Abrir →</span>
        </a>
        <a class="index-row" href={`${base}presidencia/`}>
          <span class="card-meta">Governo</span>
          <div>
            <h3>Presidência</h3>
            <p>Instituições, legislação e capacidade de Estado.</p>
          </div>
          <span class="index-cta">Abrir →</span>
        </a>
        <a class="index-row" href={`${base}brasil/`}>
          <span class="card-meta">Dossiê bilateral</span>
          <div>
            <h3>Nixon e o Brasil</h3>
            <p>Relações hemisféricas, barganha e documentos do FRUS.</p>
          </div>
          <span class="index-cta">Abrir →</span>
        </a>
        <a class="index-row" href={`${base}biografia/`}>
          <span class="card-meta">Trajetória</span>
          <div>
            <h3>Biografia</h3>
            <p>De Whittier à Casa Branca e aos anos posteriores à Presidência.</p>
          </div>
          <span class="index-cta">Abrir →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section navy cta-brasil">
    <div class="shell-main cta-brasil-inner">
      <div>
        <p class="kicker light">Dossiê</p>
        <h2>O Brasil no arquivo dos anos Nixon.</h2>
      </div>
      <div>
        <p>Café, status regional, energia e fricção diplomática — os documentos que registram Washington tratando o Brasil como ator no hemisfério.</p>
        <div class="actions">
          <a class="btn primary" href={`${base}brasil/`}>Dossiê Brasil</a>
          <a class="btn ghost" href={`${base}artigos/brasil-potencia-regional/`}>Ler o ensaio</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
