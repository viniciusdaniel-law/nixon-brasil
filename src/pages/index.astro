---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { imageAtWidth, imageSrcset } from '../lib/images';
import { formatDate } from '../lib/dates';
import home from '../data/settings/home.json';
import seo from '../data/settings/seo.json';
import '../styles/home.css';

const base = import.meta.env.BASE_URL;
const articles = (await getCollection('artigos', ({ data }) => !data.draft))
  .sort((a, b) => (
    b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
    || a.id.localeCompare(b.id, 'pt-BR')
  ));

const lead = articles.find((article) => article.data.homePlacement === 'lead') ?? articles[0];
const rail = articles
  .filter((article) => article.id !== lead?.id && article.data.homePlacement === 'rail')
  .slice(0, 4);
const heroImage = home.heroImage;
const internalUrl = (path: string) => `${base}${path.replace(/^\//, '')}`;

function coverOf(article: (typeof articles)[number]) {
  const raw = article.data.cover ?? '';
  if (!raw) return '';
  return raw.startsWith('http') ? raw : `${base}${raw.replace(/^\//, '')}`;
}
---
<BaseLayout
  title="Nixon Brasil"
  description={seo.defaultDescription}
>
  <section class="hero">
    <img
      class="hero-media"
      src={imageAtWidth(heroImage, 1600)}
      srcset={imageSrcset(heroImage, [640, 960, 1280, 1600])}
      sizes="100vw"
      alt={home.heroAlt}
      width="1600"
      height="900"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-content">
      <div class="hero-copy">
        <p class="kicker light">{home.eyebrow}</p>
        <h1>{home.title}</h1>
        <p class="hero-lead">{home.introduction}</p>
        <div class="actions">
          <a class="btn primary" href={internalUrl(home.primaryUrl)}>{home.primaryLabel}</a>
          <a class="btn ghost" href={internalUrl(home.secondaryUrl)}>{home.secondaryLabel}</a>
        </div>
      </div>
    </div>
    <div class="hero-note">
      <div class="shell">
        <span>Fotografia: {home.heroCredit}</span>
      </div>
    </div>
  </section>

  {lead && (
    <section class="section white home-feature">
      <div class="shell">
        <div class="editorial-head">
          <h2>Em destaque</h2>
          <a href={`${base}artigos/`}>Todos os artigos →</a>
        </div>

        <div class="editorial-grid">
          <a class="lead-story" href={`${base}artigos/${lead.id}/`}>
            {coverOf(lead)
              ? <img src={imageAtWidth(coverOf(lead), 1280)} srcset={imageSrcset(coverOf(lead), [640, 960, 1280])} sizes="(max-width: 900px) calc(100vw - 24px), 65vw" alt={lead.data.coverAlt ?? ''} width="1200" height="675" loading="lazy" decoding="async" />
              : <div class="card-cover-fallback lead-fallback" aria-hidden="true">{lead.data.category}</div>}
            <span class="card-meta">{lead.data.category} · {formatDate(lead.data.publishedAt)}</span>
            <h3>{lead.data.title}</h3>
            <p>{lead.data.subtitle ?? lead.data.description}</p>
          </a>

          {rail.length > 0 && (
            <div class="compact-list" aria-label="Outros artigos em destaque">
              {rail.map((article) => (
                <a class="compact-story" href={`${base}artigos/${article.id}/`}>
                  <span class="card-meta">{article.data.category}</span>
                  <h3>{article.data.title}</h3>
                  <p>{article.data.description}</p>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="section home-index-section">
    <div class="shell">
      <div class="editorial-head">
        <h2>Seções</h2>
      </div>
      <div class="index-list">
        <a class="index-row" href={`${base}politica-externa/`}>
          <span class="card-meta">Diplomacia</span>
          <div>
            <h3>Política externa</h3>
            <p>China, détente, guerras e negociação entre potências.</p>
          </div>
          <span class="index-cta">Abrir →</span>
        </a>
        <a class="index-row" href={`${base}presidencia/`}>
          <span class="card-meta">Governo</span>
          <div>
            <h3>Presidência</h3>
            <p>Governo interno, economia, direitos, meio ambiente e Watergate.</p>
          </div>
          <span class="index-cta">Abrir →</span>
        </a>
        <a class="index-row" href={`${base}brasil/`}>
          <span class="card-meta">Dossiê bilateral</span>
          <div>
            <h3>Nixon e o Brasil</h3>
            <p>Consulta estratégica, negociação e documentos do FRUS.</p>
          </div>
          <span class="index-cta">Abrir →</span>
        </a>
        <a class="index-row" href={`${base}biografia/`}>
          <span class="card-meta">Trajetória</span>
          <div>
            <h3>Biografia</h3>
            <p>De Whittier à Casa Branca, à renúncia e à pós-Presidência.</p>
          </div>
          <span class="index-cta">Abrir →</span>
        </a>
        <a class="index-row" href={`${base}cronologia/`}>
          <span class="card-meta">Linha do tempo</span>
          <div><h3>Cronologia</h3><p>Eventos documentados da formação à pós-Presidência.</p></div>
          <span class="index-cta">Abrir →</span>
        </a>
        <a class="index-row" href={`${base}discursos/`}>
          <span class="card-meta">Retórica</span>
          <div><h3>Discursos</h3><p>Texto, contexto, referência original e tradução.</p></div>
          <span class="index-cta">Abrir →</span>
        </a>
        <a class="index-row" href={`${base}pessoas/`}>
          <span class="card-meta">Índice biográfico</span>
          <div><h3>Pessoas</h3><p>Dirigentes, diplomatas e assessores ligados aos documentos.</p></div>
          <span class="index-cta">Abrir →</span>
        </a>
        <a class="index-row" href={`${base}temas/`}>
          <span class="card-meta">Dossiês</span>
          <div><h3>Temas</h3><p>Conjuntos documentais para pesquisa orientada.</p></div>
          <span class="index-cta">Abrir →</span>
        </a>
        <a class="index-row" href={`${base}galerias/`}>
          <span class="card-meta">Arquivo visual</span>
          <div><h3>Galerias</h3><p>Fotografias com identificação, crédito e fonte.</p></div>
          <span class="index-cta">Abrir →</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
